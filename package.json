{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "verify": "bash scripts/verify-dist.sh",
    "preflight": "astro check && astro build && bash scripts/verify-dist.sh",
    "preview": "astro preview",
    "check": "astro check",
    "new": "node scripts/new-note.mjs",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=personal-blog --branch=main",
    "deploy:preview": "pnpm build && wrangler pages deploy dist --project-name=personal-blog"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
