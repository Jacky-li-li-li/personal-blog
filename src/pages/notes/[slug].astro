---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteArticle from '../../components/NoteArticle.astro';
import SceneCursor from '../../components/SceneCursor.astro';
import { site } from '../../data/site';
import { getPublishedNotes, getNoteSlug } from '../../utils/notes';
import { toIsoDate } from '../../utils/date';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();

  return notes.map((note) => ({
    params: { slug: getNoteSlug(note) },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const slug = getNoteSlug(note);
const publishedIso = toIsoDate(note.data.date);
const updatedIso = note.data.updated ? toIsoDate(note.data.updated) : undefined;
const articleUrl = new URL(`/notes/${slug}`, Astro.site ?? site.siteUrl).href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: note.data.title,
  description: note.data.summary,
  datePublished: publishedIso,
  ...(updatedIso ? { dateModified: updatedIso } : {}),
  inLanguage: 'zh-CN',
  mainEntityOfPage: articleUrl,
  url: articleUrl,
  image: new URL(site.ogImage, Astro.site ?? site.siteUrl).href,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: site.name,
  },
};
---

<BaseLayout
  title={note.data.title}
  description={note.data.summary}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  jsonLd={articleJsonLd}
>
  <SceneCursor theme="sand" />
  <NoteArticle note={note}>
    <Content />
  </NoteArticle>
</BaseLayout>
