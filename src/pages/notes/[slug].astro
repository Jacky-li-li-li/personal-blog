---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getPublishedNotes, getNoteSlug } from '../../utils/notes';
import { getReadingMinutes } from '../../utils/readingTime';
import { formatLongDate, formatMonthYear, toIsoDate } from '../../utils/date';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();

  return notes.map((note) => ({
    params: { slug: getNoteSlug(note) },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const slug = getNoteSlug(note);
const minutes = getReadingMinutes(note.body ?? '');
const publishedIso = toIsoDate(note.data.date);
const updatedIso = note.data.updated ? toIsoDate(note.data.updated) : undefined;
const articleUrl = new URL(`/notes/${slug}`, Astro.site ?? site.siteUrl).href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: note.data.title,
  description: note.data.summary,
  datePublished: publishedIso,
  ...(updatedIso ? { dateModified: updatedIso } : {}),
  inLanguage: 'zh-CN',
  mainEntityOfPage: articleUrl,
  url: articleUrl,
  image: new URL(site.ogImage, Astro.site ?? site.siteUrl).href,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: site.name,
  },
};
---

<BaseLayout
  title={note.data.title}
  description={note.data.summary}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  jsonLd={articleJsonLd}
>
  <article class="article">
    <a class="back" href="/notes">
      <svg
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10.2 6H1.8M5 2.8 1.8 6 5 9.2"></path>
      </svg>
      Notes
    </a>

    <h1>{note.data.title}</h1>

    <div class="meta">
      <time datetime={publishedIso}>{formatLongDate(note.data.date)}</time>
      <span class="sep" aria-hidden="true"></span>
      <span>{minutes} 分钟</span>
    </div>

    {note.data.tags.length > 0 && (
      <ul class="post-tags" aria-label="标签">
        {note.data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    )}

    <div class="prose">
      <Content />
    </div>

    <div class="post-foot">
      <span>写于 {formatMonthYear(note.data.date)}</span>
      <a class="back" href="/notes">返回 Notes</a>
    </div>
  </article>
</BaseLayout>
