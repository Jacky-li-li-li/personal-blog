---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockField from '../components/BlockField.astro';
import Hero from '../components/Hero.astro';
import NoteRow from '../components/NoteRow.astro';
import { personJsonLd, site } from '../data/site';
import { getPublishedNotes } from '../utils/notes';

const notes = (await getPublishedNotes()).slice(0, 3);
---

<BaseLayout jsonLd={personJsonLd}>
  <div class="home">
    <div class="home-content">
      <div class="home-hero">
        <BlockField />
        <Hero />
      </div>

      <section class="teaser" aria-labelledby="teaser-title">
        <div class="section-head">
          <h2 class="label" id="teaser-title">Experience &amp; Projects</h2>
          <a class="more" href="/work">
            查看经历与项目
            <svg
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M1.8 6h8.4M7 2.8 10.2 6 7 9.2"></path>
            </svg>
          </a>
        </div>
        <p class="teaser-text">
          2024 年加入安克创新，主导虚拟用户访谈、VOC 洞察 Agent、BEES 体验数据系统与 BEC 最佳体验目录。
        </p>
      </section>

      <section class="recent" aria-labelledby="recent-title">
        <div class="section-head">
          <h2 class="label" id="recent-title">Recent Notes</h2>
          <a class="more" href="/notes">
            查看全部笔记
            <svg
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M1.8 6h8.4M7 2.8 10.2 6 7 9.2"></path>
            </svg>
          </a>
        </div>

        {notes.length > 0 ? (
          <div class="notes-list">
            {notes.map((note) => <NoteRow note={note} />)}
          </div>
        ) : (
          <p class="empty-state">
            第一篇还在路上。想第一时间看到更新，可以 <a href={`mailto:${site.email}`}>写封邮件</a>。
          </p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
