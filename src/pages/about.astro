---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutLandscape from '../components/AboutLandscape.astro';
import Hero from '../components/Hero.astro';
import { personJsonLd } from '../data/site';

const description =
  '李连硕（Jacky Li），AI 产品经理。2024 年加入安克创新，负责体验域 AI 产品从 0 到 1：虚拟用户访谈、VOC 洞察 Agent、BEES 体验数据系统与 BEC 最佳体验目录。';
---

<BaseLayout title="About" description={description} jsonLd={personJsonLd}>
  <div class="about-page">
    <AboutLandscape />
    <Hero />
  </div>
</BaseLayout>
