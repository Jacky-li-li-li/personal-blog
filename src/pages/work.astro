---
import BaseLayout from '../layouts/BaseLayout.astro';
import Experience from '../components/Experience.astro';
import WorkLandscape from '../components/WorkLandscape.astro';

const description =
  '李连硕（Jacky Li）的工作经历与代表项目：虚拟用户访谈、VOC 洞察 Agent、BEES 体验数据系统与 BEC 最佳体验目录。';
---

<BaseLayout title="Work" description={description}>
  <div class="work-page" data-work-page>
    <WorkLandscape />

    <svg class="work-river" data-work-river aria-hidden="true">
      <defs>
        <linearGradient id="work-river-gradient" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="var(--work-water)" stop-opacity="0.24" />
          <stop offset="0.46" stop-color="var(--work-water)" stop-opacity="0.52" />
          <stop offset="0.84" stop-color="var(--accent-ink)" stop-opacity="0.34" />
          <stop offset="0.96" stop-color="var(--accent-ink)" stop-opacity="0.2" />
          <stop offset="1" stop-color="var(--accent-ink)" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="work-mountain-river-fade" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="white" />
          <stop offset="0.45" stop-color="white" />
          <stop offset="1" stop-color="white" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="work-lower-river-fade" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="white" stop-opacity="0" />
          <stop offset="1" stop-color="white" />
        </linearGradient>
        <filter id="work-river-rough" x="-12%" y="-4%" width="124%" height="108%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.035 0.12" numOctaves="2" seed="11" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.65" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <mask id="work-terrain-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="-100%" y="-100%" width="300%" height="300%">
          <g data-work-terrain-transform fill="white">
            <path d="M-90 360V246L70 198l98 24 158-110 82 76 106-48 132 88 118-76 116 68 134-96 104 76 126-94 122 80 112-46 222 106v114Z" />
            <path d="M-100 360v-72l218-70 142 36 172-118 100 96 112-46 124 88 176-118 122 76 118-56 142 80 138-92 260 126v70Z" />
            <path d="M-100 360v-34l222-54 158 52 202-98 178 88 202-62 190 66 218-84 162 72 168-58 120 52v60Z" />
          </g>
        </mask>
        <mask id="work-mountain-bank-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="-100%" y="-100%" width="300%" height="300%">
          <rect x="-4000" y="-1000" width="9000" height="9000" fill="url(#work-mountain-river-fade)" />
        </mask>
        <mask id="work-lower-river-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="-100%" y="-100%" width="300%" height="300%">
          <rect x="-4000" y="-1000" width="9000" height="9000" fill="url(#work-lower-river-fade)" />
        </mask>
        <mask id="work-water-front-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="-100%" y="-100%" width="300%" height="300%">
          <rect data-work-water-front x="-4000" y="0" width="9000" height="0" fill="white" />
        </mask>
      </defs>
      <g class="work-river-channel" mask="url(#work-terrain-mask)">
        <g mask="url(#work-mountain-bank-mask)">
          <path class="work-river-bank" data-work-mountain-bank filter="url(#work-river-rough)" />
          <path class="work-river-snow" data-work-mountain-snow />
        </g>
        <path class="work-river-bed" data-work-mountain-bed filter="url(#work-river-rough)" />
        <g mask="url(#work-water-front-mask)">
          <path class="work-river-water" data-work-mountain-water />
        </g>
      </g>
      <g class="work-river-channel" mask="url(#work-lower-river-mask)">
        <path class="work-river-bed" data-work-river-bed filter="url(#work-river-rough)" />
        <g mask="url(#work-water-front-mask)">
          <path class="work-river-water" data-work-river-water />
        </g>
      </g>
    </svg>

    <header class="work-head page-head">
      <p class="label">Work</p>
      <h1>经历与项目。</h1>
      <p>从体验问题出发，把 AI 做成真正可用的产品。</p>
    </header>

    <Experience />
  </div>
</BaseLayout>

<script>
  type RiverPoint = { x: number; y: number; width: number };

  const workPage = document.querySelector<HTMLElement>('[data-work-page]');

  if (workPage) {
    const river = workPage.querySelector<SVGSVGElement>('[data-work-river]');
    const mountains = workPage.querySelector<SVGSVGElement>('[data-work-mountains]');
    const terrainTransform = workPage.querySelector<SVGGElement>('[data-work-terrain-transform]');
    const mountainBank = workPage.querySelector<SVGPathElement>('[data-work-mountain-bank]');
    const mountainSnow = workPage.querySelector<SVGPathElement>('[data-work-mountain-snow]');
    const mountainBed = workPage.querySelector<SVGPathElement>('[data-work-mountain-bed]');
    const mountainWater = workPage.querySelector<SVGPathElement>('[data-work-mountain-water]');
    const bed = workPage.querySelector<SVGPathElement>('[data-work-river-bed]');
    const water = workPage.querySelector<SVGPathElement>('[data-work-river-water]');
    const landscape = workPage.querySelector<HTMLElement>('[data-work-landscape]');
    const gradient = workPage.querySelector<SVGLinearGradientElement>('#work-river-gradient');
    const mountainFade = workPage.querySelector<SVGLinearGradientElement>('#work-mountain-river-fade');
    const lowerFade = workPage.querySelector<SVGLinearGradientElement>('#work-lower-river-fade');
    const waterFront = workPage.querySelector<SVGRectElement>('[data-work-water-front]');
    let frame = 0;
    let flowFrame = 0;
    let lastLayoutKey = '';

    const drawRiver = () => {
      frame = 0;
      const first = workPage.querySelector<HTMLElement>('[data-experience]');
      if (
        !river || !mountains || !terrainTransform || !mountainBank || !mountainSnow ||
        !mountainBed || !mountainWater || !bed || !water || !landscape || !gradient ||
        !mountainFade || !lowerFade || !first
      ) return;

      const bounds = river.getBoundingClientRect();
      const itemBounds = first.getBoundingClientRect();
      const sceneBounds = landscape.getBoundingClientRect();
      const nodeStyle = getComputedStyle(first, '::after');
      const nodeSize = Number.parseFloat(nodeStyle.width) || 9;
      const nodeLeft = Number.parseFloat(nodeStyle.left) || 0;
      const nodeTop = Number.parseFloat(nodeStyle.top) || 0;
      const x = itemBounds.left + nodeLeft + nodeSize / 2 - bounds.left;
      const firstY = itemBounds.top + nodeTop + nodeSize / 2 - bounds.top;
      const mobile = window.matchMedia('(max-width: 760px)').matches;
      const sourceY = mobile ? 104 : 140;
      const sceneBottom = sceneBounds.bottom - bounds.top;

      // 经历面板开合不改变河道几何（河道止于首个节点，面板都在它下方）。
      // 布局指纹未变时跳过重建，避免过渡期间逐帧重绘导致闪烁。
      const layoutKey = [
        Math.round(bounds.width), Math.round(x), Math.round(firstY),
        Math.round(sceneBottom), mobile ? 1 : 0,
      ].join('|');
      if (layoutKey === lastLayoutKey) return;
      lastLayoutKey = layoutKey;

      const bend = mobile ? 8 : 26;
      const widthScale = mobile ? 0.58 : 1;
      const mountainSpan = sceneBottom - sourceY;
      const lowerSpan = firstY - sceneBottom;

      // 不对称间距与偏移模拟自然河道；width 是半宽，向下游逐渐收窄。
      const knots = [
        [sourceY, 0, 0.42],
        [sourceY + mountainSpan * 0.1, -0.18, 0.72],
        [sourceY + mountainSpan * 0.24, -0.86, 1.3],
        [sourceY + mountainSpan * 0.37, -0.62, 2.15],
        [sourceY + mountainSpan * 0.5, 0.42, 2.75],
        [sourceY + mountainSpan * 0.63, 0.95, 2.1],
        [sourceY + mountainSpan * 0.76, 0.18, 3],
        [sourceY + mountainSpan * 0.9, -0.52, 2.2],
        [sceneBottom, -0.12, 1.8],
        [sceneBottom + lowerSpan * 0.14, 0.28, 1.5],
        [sceneBottom + lowerSpan * 0.32, -0.38, 1.25],
        [sceneBottom + lowerSpan * 0.51, -0.16, 1],
        [sceneBottom + lowerSpan * 0.72, 0.06, 0.75],
        [firstY, 0, 0.5],
      ].map(([y, offset, width]) => ({ x: x + offset * bend, y, width: width * widthScale }));

      const sample = (points: RiverPoint[]) => {
        const result: RiverPoint[] = [];
        for (let i = 0; i < points.length - 1; i += 1) {
          const p0 = points[Math.max(0, i - 1)];
          const p1 = points[i];
          const p2 = points[i + 1];
          const p3 = points[Math.min(points.length - 1, i + 2)];
          for (let step = 0; step < 10; step += 1) {
            const t = step / 10;
            const t2 = t * t;
            const t3 = t2 * t;
            const interpolate = (key: keyof RiverPoint) =>
              0.5 * (2 * p1[key] + (-p0[key] + p2[key]) * t +
                (2 * p0[key] - 5 * p1[key] + 4 * p2[key] - p3[key]) * t2 +
                (-p0[key] + 3 * p1[key] - 3 * p2[key] + p3[key]) * t3);
            result.push({ x: interpolate('x'), y: interpolate('y'), width: interpolate('width') });
          }
        }
        result.push(points[points.length - 1]);
        return result;
      };

      const ribbon = (points: RiverPoint[], bank = 0) => {
        const left: [number, number][] = [];
        const right: [number, number][] = [];
        points.forEach((point, index) => {
          const previous = points[Math.max(0, index - 1)];
          const next = points[Math.min(points.length - 1, index + 1)];
          const dx = next.x - previous.x;
          const dy = next.y - previous.y;
          const length = Math.hypot(dx, dy) || 1;
          const halfWidth = Math.max(0.42, point.width + bank);
          const nx = (-dy / length) * halfWidth;
          const ny = (dx / length) * halfWidth;
          left.push([point.x + nx, point.y + ny]);
          right.push([point.x - nx, point.y - ny]);
        });
        const round = (value: number) => Number(value.toFixed(2));
        const outline = [...left, ...right.reverse()];
        return `${outline.map(([px, py], index) => `${index === 0 ? 'M' : 'L'}${round(px)} ${round(py)}`).join(' ')} Z`;
      };

      // SVG 高度按河道实际范围固定（首个节点 + 余量），与页面高度解耦：
      // 面板开合过渡改变页面高度时，元素尺寸稳定，viewBox 不会与布局错帧。
      const svgHeight = Math.ceil(firstY + 48);
      river.setAttribute('viewBox', `0 0 ${bounds.width} ${svgHeight}`);
      river.style.height = `${svgHeight}px`;

      // 将三座山的实际轮廓映射到河道坐标系，山体外的河段一律裁掉。
      const riverMatrix = river.getCTM();
      const mountainMatrix = mountains.getCTM();
      if (riverMatrix && mountainMatrix) {
        const matrix = riverMatrix.inverse().multiply(mountainMatrix);
        terrainTransform.setAttribute(
          'transform',
          `matrix(${matrix.a} ${matrix.b} ${matrix.c} ${matrix.d} ${matrix.e} ${matrix.f})`,
        );
      }

      // 两段共用完整中心线，避免接缝处因采样邻点不同而产生切线或宽度突变。
      const centerline = sample(knots);
      mountainBank.setAttribute('d', ribbon(centerline, mobile ? 2.8 : 4.2));
      mountainSnow.setAttribute('d', ribbon(centerline, mobile ? 1.7 : 2.5));
      mountainBed.setAttribute('d', ribbon(centerline, mobile ? 0.8 : 1.2));
      mountainWater.setAttribute('d', ribbon(centerline));
      bed.setAttribute('d', ribbon(centerline, mobile ? 1.1 : 2));
      water.setAttribute('d', ribbon(centerline));

      gradient.setAttribute('y1', String(sourceY));
      gradient.setAttribute('y2', String(firstY));
      gradient.setAttribute('x1', String(x));
      gradient.setAttribute('x2', String(x));
      mountainFade.setAttribute('y1', String(sceneBottom - (mobile ? 24 : 32)));
      mountainFade.setAttribute('y2', String(sceneBottom));
      mountainFade.setAttribute('x1', String(x));
      mountainFade.setAttribute('x2', String(x));
      lowerFade.setAttribute('y1', String(sceneBottom - (mobile ? 36 : 48)));
      lowerFade.setAttribute('y2', String(sceneBottom - (mobile ? 8 : 12)));
      lowerFade.setAttribute('x1', String(x));
      lowerFade.setAttribute('x2', String(x));
    };

    const requestDraw = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(drawRiver);
    };

    // 水位与阅读线（视口 38%）同步推进：滚动时水面沿河道下行，越过首个经历节点后
    // 由时间线上的青碧水流续接；河床全程完整，作为水位前方的干涸河床。
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const updateWaterFront = () => {
      flowFrame = 0;
      const first = workPage.querySelector<HTMLElement>('[data-experience]');
      if (!waterFront || !river || !first) return;
      if (reducedMotion.matches) {
        waterFront.setAttribute('height', String(river.getBoundingClientRect().height));
        return;
      }
      const bounds = river.getBoundingClientRect();
      const nodeStyle = getComputedStyle(first, '::after');
      const nodeTop = Number.parseFloat(nodeStyle.top) || 0;
      const nodeSize = Number.parseFloat(nodeStyle.width) || 9;
      const firstY = first.getBoundingClientRect().top + nodeTop + nodeSize / 2 - bounds.top;
      // bounds.top 是视口坐标，阅读线同样用视口坐标换算，不能再叠加 scrollY。
      const readingLine = window.innerHeight * 0.38 - bounds.top;
      const front = Math.min(firstY, Math.max(0, readingLine));
      waterFront.setAttribute('height', String(Math.max(0, front)));
    };

    const requestWaterFront = () => {
      if (flowFrame) return;
      flowFrame = window.requestAnimationFrame(updateWaterFront);
    };

    drawRiver();
    updateWaterFront();
    new ResizeObserver(requestDraw).observe(workPage);
    workPage.addEventListener('transitionend', requestDraw);
    window.addEventListener('resize', () => {
      requestDraw();
      requestWaterFront();
    });
    window.addEventListener('scroll', requestWaterFront, { passive: true });
    reducedMotion.addEventListener('change', requestWaterFront);
    document.fonts.ready.then(requestDraw);
  }
</script>
