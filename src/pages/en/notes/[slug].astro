---
/**
 * 笔记正文（英文）：只为有译文的条目生成页面，渲染英文译文条目本身。
 *
 * 没有译文的笔记不会出现在 /en 下，中文页的语言切换据此回退到英文列表页，
 * 不会把读者带到一个 404。
 */
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteArticle from '../../../components/NoteArticle.astro';
import SceneCursor from '../../../components/SceneCursor.astro';
import { site } from '../../../data/site';
import { getNotePairs, toNoteView, type NotePair } from '../../../utils/notes';
import { toIsoDate } from '../../../utils/date';
import { HTML_LANG, localizePath } from '../../../i18n';

export async function getStaticPaths() {
  const pairs = await getNotePairs();
  return pairs
    .filter((pair) => Boolean(pair.en))
    .map((pair) => ({ params: { slug: pair.id }, props: { pair } }));
}

interface Props {
  pair: NotePair;
}

const locale = 'en' as const;
const view = toNoteView(Astro.props.pair, locale);
const { Content } = await render(view.entry);

const publishedIso = toIsoDate(view.date);
const updatedIso = view.updated ? toIsoDate(view.updated) : undefined;
const articleUrl = new URL(localizePath(`/notes/${view.id}`, locale), Astro.site ?? site.siteUrl).href;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: view.title,
  description: view.summary,
  datePublished: publishedIso,
  ...(updatedIso ? { dateModified: updatedIso } : {}),
  inLanguage: HTML_LANG[locale],
  mainEntityOfPage: articleUrl,
  url: articleUrl,
  image: new URL(site.ogImage, Astro.site ?? site.siteUrl).href,
  author: { '@type': 'Person', name: site.name[locale], url: site.siteUrl },
  publisher: { '@type': 'Person', name: site.name[locale] },
};
---

<BaseLayout
  locale={locale}
  title={view.title}
  description={view.summary}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  jsonLd={articleJsonLd}
  localeSwitchHref={localizePath(`/notes/${view.id}`, 'zh')}
>
  <SceneCursor theme="sand" />
  <NoteArticle note={view}>
    <Content />
  </NoteArticle>
</BaseLayout>
