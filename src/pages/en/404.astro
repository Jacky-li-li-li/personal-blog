---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUI } from '../../i18n';

const ui = getUI('en');
---

<BaseLayout locale="en" title={ui.notFound.title} noindex hasAlternate={false}>
  <div class="notfound">
    <p class="code" aria-hidden="true">404</p>
    <h1>{ui.notFound.heading}</h1>
    <p>{ui.notFound.body}</p>
    <a class="back" href="/en">
      <svg
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10.2 6H1.8M5 2.8 1.8 6 5 9.2"></path>
      </svg>
      {ui.notFound.back}
    </a>
  </div>
</BaseLayout>
