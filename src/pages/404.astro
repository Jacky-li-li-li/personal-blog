---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" noindex>
  <div class="notfound">
    <p class="code" aria-hidden="true">404</p>
    <h1>这一页不存在</h1>
    <p>可能是链接过期了，或者页面已经搬走。</p>
    <a class="back" href="/">
      <svg
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10.2 6H1.8M5 2.8 1.8 6 5 9.2"></path>
      </svg>
      返回首页
    </a>
  </div>
</BaseLayout>
