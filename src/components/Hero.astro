---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import SocialIcon from './SocialIcon.astro';
import { site } from '../data/site';
---

<header class="hero" id="about">
  <div class="profile">
    <div class="profile-id">
      <Image
        src={avatar}
        alt={`${site.name} 的插画头像`}
        widths={[144, 288]}
        sizes="(max-width: 760px) 116px, 144px"
        format="webp"
        quality={82}
        class="avatar"
        loading="eager"
        fetchpriority="high"
      />

      <nav class="socials" aria-label="联系方式">
        {site.socials.map((social) => {
          const external = social.href.startsWith('http');
          return (
            <a
              class="social-link"
              data-icon={social.icon}
              href={social.href}
              aria-label={`${social.label}${external ? '（新窗口打开）' : ''}`}
              title={social.label}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
            >
              <SocialIcon icon={social.icon} />
            </a>
          );
        })}
      </nav>
    </div>

    <h1 class="profile-name">{site.name}</h1>

    <div class="profile-bio">
      <p class="lede">{site.tagline}</p>
      <p class="intro blur-highlight" set:html={site.intro}></p>
      <script is:inline>
        // 把简介拆成「英文词 / 中文单字 / 标点」序列，按顺序给出递增延迟，
        // 形成从左到右依次清晰的扫过效果；无脚本时文字保持正常可见。
        (() => {
          const intro = document.querySelector('.intro.blur-highlight');
          if (!intro) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          let index = 0;
          const split = (node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              const frag = document.createDocumentFragment();
              const tokens = node.textContent.match(/[A-Za-z0-9][A-Za-z0-9+#._-]*|\s+|[^\s]/g) || [];
              tokens.forEach((token) => {
                if (/^\s+$/.test(token)) {
                  frag.appendChild(document.createTextNode(token));
                  return;
                }
                const span = document.createElement('span');
                span.className = 'char';
                span.style.setProperty('--i', index++);
                span.textContent = token;
                frag.appendChild(span);
              });
              return frag;
            }
            // 元素（如高亮用的 <strong>）整体作为一个单元，
            // 让它的背景底纹与文字同步淡入，而不是先露出一条底纹。
            const clone = node.cloneNode(true);
            clone.classList.add('char-block');
            clone.style.setProperty('--i', index++);
            return clone;
          };

          const replacement = document.createDocumentFragment();
          intro.childNodes.forEach((child) => replacement.appendChild(split(child)));
          intro.replaceChildren(replacement);
        })();
      </script>

      {site.tags.length > 0 && (
        <ul class="identity-tags" aria-label="身份标签">
          {site.tags.map((tag) => (
            <li class="identity-tag">
              <span class="identity-tag-text">
                <span class="identity-tag-hash" aria-hidden="true">#</span>{tag}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</header>

<script is:inline>
  // 身份标签的「对焦」柔光跟随指针：把落点写进自定义属性，交给 CSS 渲染。
  (() => {
    const tags = document.querySelectorAll('.identity-tag');
    if (!tags.length) return;
    if (!window.matchMedia('(hover: hover)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    tags.forEach((tag) => {
      let frame = 0;
      let x = 50;
      let y = 50;

      const paint = () => {
        frame = 0;
        tag.style.setProperty('--spot-x', `${x}%`);
        tag.style.setProperty('--spot-y', `${y}%`);
      };

      tag.addEventListener('pointermove', (event) => {
        const rect = tag.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        x = Math.min(100, Math.max(0, ((event.clientX - rect.left) / rect.width) * 100));
        y = Math.min(100, Math.max(0, ((event.clientY - rect.top) / rect.height) * 100));
        if (!frame) frame = requestAnimationFrame(paint);
      });
    });
  })();
</script>
