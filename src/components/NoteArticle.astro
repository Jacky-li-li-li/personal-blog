---
/**
 * Notes 正文外壳：顶部返回链接、标题、元信息、正文 slot。
 *
 * tags 仍保存在 frontmatter 里备用，正文不渲染。
 * 中英文都经由 pages/notes/[slug].astro 与 pages/en/notes/[slug].astro 渲染到这里，
 * 语言只影响文案与日期格式，正文 Markdown 由调用方按语言选好。
 */
import type { Note } from '../utils/notes';
import { formatLongDate, toIsoDate } from '../utils/date';
import { getReadingMinutes } from '../utils/readingTime';
import { getUI, localizePath } from '../i18n';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const ui = getUI(note.locale);
const minutes = getReadingMinutes(note.entry.body ?? '');
const publishedIso = toIsoDate(note.date);
---

<article class="article note-article">
  <a class="back" href={localizePath('/notes', note.locale)}>
    <svg
      viewBox="0 0 12 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M10.2 6H1.8M5 2.8 1.8 6 5 9.2"></path>
    </svg>
    {ui.notes.backLink}
  </a>

  <header class="article-header">
    <h1>{note.title}</h1>

    <div class="meta">
      <time datetime={publishedIso}>{formatLongDate(note.date, note.locale)}</time>
      <span class="sep" aria-hidden="true"></span>
      <span>{ui.notes.readingTime(minutes)}</span>
      <span class="meta-views">
        <span class="sep" aria-hidden="true"></span>
        <span class="note-views" data-note-views data-slug={note.id} data-mode="hit"></span>
      </span>
    </div>
  </header>

  <div class="prose">
    <slot />
  </div>
</article>

<script>
  import '../scripts/note-views';
</script>
