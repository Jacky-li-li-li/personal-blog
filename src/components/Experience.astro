---
import { experiences } from '../data/experience';
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import { getUI, pick } from '../i18n';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
const projectMap = new Map(projects.map((project) => [project.id, project]));
---

<section class="experience-panel reveal" id="work" aria-labelledby="experience-title">
  <h2 class="label" id="experience-title">{ui.work.experienceLabel}</h2>

  <div class="experience-list">
    <span class="experience-flow" data-experience-flow aria-hidden="true"></span>
    {experiences.map((item, index) => {
      const relatedProjects = (item.projects ?? [])
        .map((id) => projectMap.get(id))
        .filter((project) => project !== undefined);
      const hasProjects = relatedProjects.length > 0;
      const projectsId = `experience-projects-${item.id}`;
      const companyId = `experience-company-${item.id}`;
      const org = pick(item.org, locale);
      const role = pick(item.role, locale);
      const department = item.department ? pick(item.department, locale) : undefined;
      const summary = pick(item.summary, locale);
      const awards = item.awards ? pick(item.awards, locale) : undefined;

      return (
        <article
          class:list={['experience-item', { 'is-active': index === 0 }]}
          id={`experience-${item.id}`}
          aria-labelledby={companyId}
          data-experience
          data-current={item.end === 'present' ? 'true' : 'false'}
        >
          <a
            class="experience-years"
            href={`#experience-${item.id}`}
            aria-current={index === 0 ? 'location' : undefined}
            aria-label={ui.work.jumpTo(org)}
          >
            {item.start} — {item.end === 'present' ? ui.work.present : item.end}
          </a>

          <div class="experience-body">
            <h3 class="experience-heading">
              <span class="experience-toggle">
                <span class="experience-heading-row">
                  {item.logo ? (
                    <span class="experience-company-logo" id={companyId}>
                      <a
                        class="experience-logo-link"
                        href={item.website}
                        target={item.website ? '_blank' : undefined}
                        rel={item.website ? 'noopener noreferrer' : undefined}
                        aria-label={item.website ? ui.work.companySite(org) : undefined}
                      >
                        <img
                          class="experience-logo experience-logo-rest"
                          src={item.logo}
                          alt={org}
                          width="386"
                          height="210"
                          loading="eager"
                        />
                        {item.logoDark && (
                          <img
                            class="experience-logo experience-logo-reverse"
                            src={item.logoDark}
                            alt=""
                            width="386"
                            height="210"
                            loading="eager"
                          />
                        )}
                        {item.logoHover && (
                          <img
                            class="experience-logo experience-logo-hover"
                            src={item.logoHover}
                            alt=""
                            width="386"
                            height="210"
                            loading="eager"
                          />
                        )}
                      </a>
                    </span>
                  ) : (
                    <span class="experience-company" id={companyId}>{org}</span>
                  )}
                  <span class="experience-role">
                    {department ? `${department} · ` : ''}{role}
                  </span>
                </span>

                {awards && awards.length > 0 && (
                  <span class="experience-awards">
                    <span class="experience-awards-label">{ui.work.honors}</span>
                    {awards.map((award) => (
                      <span class="experience-award">{award}</span>
                    ))}
                  </span>
                )}

                <span class="experience-summary">{summary}</span>

                {hasProjects && (
                  <span class="experience-action">
                    <span>{ui.work.representativeProjects(relatedProjects.length)}</span>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                      <path d="m4 6 4 4 4-4"></path>
                    </svg>
                  </span>
                )}
              </span>
            </h3>

            {hasProjects && (
              <div
                class="experience-projects"
                id={projectsId}
                aria-hidden="true"
                inert
                data-experience-projects
              >
                <div class="experience-projects-inner">
                  <div class="experience-projects-heading">
                    <span>{ui.work.selectedWork}</span>
                    <span>{ui.work.projectCount(relatedProjects.length)}</span>
                  </div>
                  <ul class="experience-project-list">
                    {relatedProjects.map((project) => (
                      <ProjectCard project={project} locale={locale} />
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <div class="project-preview" data-project-preview-layer aria-hidden="true">
    <svg class="project-preview-curve" data-project-preview-curve aria-hidden="true">
      <path data-project-preview-path fill="none"></path>
    </svg>
    <aside class="project-preview-panel" data-project-preview-panel>
      <div class="project-preview-images" data-project-preview-images></div>
    </aside>
  </div>
</section>

<script>
  const experienceItems = Array.from(
    document.querySelectorAll<HTMLElement>('[data-experience]'),
  );
  const flow = document.querySelector<HTMLElement>('[data-experience-flow]');

  /* ---------- 开合交互 ----------
     只有指针落在某段经历的「内容区」（.experience-body）时才展开该段、收起其余；
     左侧时间列（年份与轨道）不参与判定：悬停它既不展开，也不会收起已经展开的段落。
     滚动不再参与开合：页面不会自行伸缩，位置完全由指针决定。
  */
  const COLLAPSE_DELAY = 110; // 指针离开后稍等再收：从一段移到另一段时不会闪一下

  const setItemOpen = (item: HTMLElement, open: boolean) => {
    const panel = item.querySelector<HTMLElement>('[data-experience-projects]');
    if (item.classList.contains('is-open') === open) return;
    if (!open && panel && panel.contains(document.activeElement)) {
      // 面板里还有焦点时不能直接 inert：焦点会掉到 body，键盘与读屏用户当场丢失位置。
      // 先把焦点移回这一段的时间入口（同一段内，位置不跳），再收起。
      const years = item.querySelector<HTMLElement>('.experience-years');
      years?.focus({ preventScroll: true });
    }
    item.classList.toggle('is-open', open);
    if (!panel) return;
    panel.setAttribute('aria-hidden', String(!open));
    panel.inert = !open;
  };

  const canHover = window.matchMedia('(hover: hover)').matches;
  const experienceList = document.querySelector<HTMLElement>('.experience-list');
  let collapseTimer = 0;
  /** 当前展开的那一段，避免同一段重复触发展开。 */
  let currentOpen: HTMLElement | null = null;

  const cancelCollapse = () => {
    if (!collapseTimer) return;
    window.clearTimeout(collapseTimer);
    collapseTimer = 0;
  };

  /** 只展开这一段，其余收起。 */
  const openOnly = (item: HTMLElement) => {
    experienceItems.forEach((other) => setItemOpen(other, other === item));
  };

  /** 延迟收起：为「从这一段移到另一段」留出时间，避免中途闪一下。 */
  const scheduleCollapse = () => {
    cancelCollapse();
    collapseTimer = window.setTimeout(() => {
      collapseTimer = 0;
      experienceItems.forEach((item) => {
        // 焦点还在这一段里就别收：键盘用户正在读，鼠标只是顺带划过。
        const zone = item.querySelector<HTMLElement>('.experience-body');
        if (zone?.contains(document.activeElement)) return;
        setItemOpen(item, false);
      });
      currentOpen = null;
    }, COLLAPSE_DELAY);
  };

  /* 用「指针坐标 + 命中检测」判断悬停哪一段，而不是给元素绑 mouseenter/leave。
     原因：卡片开合会把相邻经历整体推走，元素边界在指针底下移动，enter/leave 会被
     误触发——实测切到下一段时，目标框 33ms 内就移出指针、列表底边也短暂缩到指针
     上方，于是刚展开又被判定「离开」而收起。按坐标命中只看指针压在谁身上，
     布局怎么动都不影响判断；而且只有指针真的移动才重算，静止时状态不会被动画带跑。 */
  let hoverPoint: { x: number; y: number } | null = null;
  let hoverFrame = 0;

  const updateHoverState = () => {
    hoverFrame = 0;
    if (!hoverPoint) return;
    const target = document.elementFromPoint(hoverPoint.x, hoverPoint.y);

    // 1) 压在内容区上：展开这一段。
    const body = target instanceof Element ? target.closest<HTMLElement>('.experience-body') : null;
    if (body && experienceList?.contains(body)) {
      cancelCollapse();
      const item = body.closest<HTMLElement>('[data-experience]');
      if (item && item !== currentOpen) {
        currentOpen = item;
        openOnly(item);
      }
      return;
    }

    // 2) 还在经历模块内，但不在内容区（时间列、条目间隙）：保持现状，不作任何反应。
    if (target instanceof Element && experienceList?.contains(target)) {
      cancelCollapse();
      return;
    }

    // 3) 已经离开整个模块：收起。
    scheduleCollapse();
  };

  if (canHover) {
    // 监听在 window 上：指针移到模块外也能收到，才能判断「离开」。
    window.addEventListener('pointermove', (event) => {
      hoverPoint = { x: event.clientX, y: event.clientY };
      if (!hoverFrame) hoverFrame = window.requestAnimationFrame(updateHoverState);
    }, { passive: true });

    // 指针移出页面（比如去点浏览器地址栏）时没有 pointermove，单独收一下。
    document.documentElement.addEventListener('pointerleave', () => {
      hoverPoint = null;
      scheduleCollapse();
    });
  }

  // 键盘等价于悬停：焦点进入内容区就展开这一段。
  experienceItems.forEach((item) => {
    const zone = item.querySelector<HTMLElement>('.experience-body');
    zone?.addEventListener('focusin', () => {
      cancelCollapse();
      currentOpen = item;
      openOnly(item);
    });
  });

  // 焦点离开整个列表时收起，与指针离开保持一致。
  if (experienceList) {
    experienceList.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && experienceList.contains(next)) return;
      // relatedTarget 在点击不可聚焦元素时为 null，等一帧再确认焦点是否真的离开了列表。
      window.setTimeout(() => {
        if (experienceList.contains(document.activeElement)) return;
        experienceItems.forEach((item) => setItemOpen(item, false));
        currentOpen = null;
      }, 0);
    });
  }

  // 时间线同时承担阅读定位：当前任职与视口内经历使用不同状态。
  // 青碧水流沿轨道随滚动以阅读线连续跟随：水位前端始终指向阅读线所在位置，
  // 范围覆盖最后一段的完整轨道与渐隐尾段；reduced-motion 下直接满水。
  let activeItem: HTMLElement | undefined;
  let frame = 0;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const updateExperienceFlow = (atPageEnd: boolean) => {
    if (!flow) return;
    const first = experienceItems[0];
    const last = experienceItems.at(-1);
    if (!first || !last || !flow.parentElement) return;
    const nodeStyle = getComputedStyle(first, '::after');
    const nodeSize = Number.parseFloat(nodeStyle.width) || 9;
    const nodeLeft = Number.parseFloat(nodeStyle.left) || 0;
    const nodeTop = Number.parseFloat(nodeStyle.top) || 0;
    const listBounds = flow.parentElement.getBoundingClientRect();
    const firstBounds = first.getBoundingClientRect();
    flow.style.left = `${(firstBounds.left + nodeLeft + nodeSize / 2 - listBounds.left).toFixed(1)}px`;
    const startY = firstBounds.top + nodeTop + nodeSize / 2 - listBounds.top;
    // 轨道终点 = 最后一段内容底部 + 渐隐尾段（:last-child::before 的 bottom 为负值）。
    const tail = Math.abs(Number.parseFloat(getComputedStyle(last, '::before').bottom)) || 0;
    const endY = last.getBoundingClientRect().bottom + tail - listBounds.top;
    flow.style.top = `${startY.toFixed(1)}px`;
    const readingLine = window.innerHeight * 0.38 - listBounds.top;
    const front = atPageEnd || reducedMotion.matches
      ? endY
      : Math.min(endY, Math.max(startY, readingLine));
    flow.style.height = `${Math.max(0, front - startY).toFixed(1)}px`;
  };

  const updateExperiencePosition = () => {
    frame = 0;
    const readingLine = window.innerHeight * 0.38;
    let next: HTMLElement | undefined = experienceItems[0];

    experienceItems.forEach((item) => {
      if (item.getBoundingClientRect().top <= readingLine) next = item;
    });

    // 页面到底时，最后一段可能无法越过阅读线，此时仍应定位到最后一段。
    const atPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atPageEnd) next = experienceItems.at(-1);

    updateExperienceFlow(atPageEnd);
    if (!next || next === activeItem) return;

    activeItem = next;
    experienceItems.forEach((item) => {
      const active = item === next;
      item.classList.toggle('is-active', active);
      const year = item.querySelector('.experience-years');
      if (active) year?.setAttribute('aria-current', 'location');
      else year?.removeAttribute('aria-current');
    });
  };

  const requestPositionUpdate = () => {
    if (frame) return;
    frame = window.requestAnimationFrame(updateExperiencePosition);
  };

  updateExperiencePosition();
  window.addEventListener('scroll', requestPositionUpdate, { passive: true });
  window.addEventListener('resize', requestPositionUpdate);


  // Hover preview: soft curve from a project card to a paper preview panel.
  // Fine-pointer + hover only; coarse pointers skip to avoid broken mobile UI.
  const previewLayer = document.querySelector<HTMLElement>('[data-project-preview-layer]');
  const previewCurve = document.querySelector<SVGSVGElement>('[data-project-preview-curve]');
  const previewPath = document.querySelector<SVGPathElement>('[data-project-preview-path]');
  const previewPanel = document.querySelector<HTMLElement>('[data-project-preview-panel]');
  const previewImages = document.querySelector<HTMLElement>('[data-project-preview-images]');
  const previewCards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-project-preview]'),
  );
  const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  let previewCard: HTMLElement | null = null;
  let previewFrame = 0;
  let previewHideTimer = 0;

  const clearPreviewImages = () => {
    if (!previewImages) return;
    previewImages.replaceChildren();
  };

  const loadPreviewImages = (srcs: string[]) => {
    if (!previewImages) return;
    clearPreviewImages();
    srcs.forEach((src, index) => {
      const figure = document.createElement('figure');
      figure.className = 'project-preview-figure';

      const titlebar = document.createElement('div');
      titlebar.className = 'project-preview-titlebar';
      titlebar.setAttribute('aria-hidden', 'true');
      for (const kind of ['close', 'minimize', 'zoom'] as const) {
        const dot = document.createElement('span');
        dot.className = `project-preview-traffic project-preview-traffic--${kind}`;
        titlebar.append(dot);
      }

      const img = document.createElement('img');
      img.src = src;
      img.alt = '';
      img.loading = index === 0 ? 'eager' : 'lazy';
      img.decoding = 'async';

      figure.append(titlebar, img);
      previewImages.append(figure);
    });
  };

  const placePreviewPanel = (card: HTMLElement) => {
    if (!previewPanel) return;
    const cardRect = card.getBoundingClientRect();
    const panelWidth = Math.min(340, Math.max(260, window.innerWidth * 0.26));
    const margin = 28;
    const gap = 52;
    // Prefer a clear gap to the right of the card; otherwise pin near viewport right.
    const fromCard = cardRect.right + gap;
    const pinnedRight = window.innerWidth - panelWidth - margin;
    let left = fromCard + panelWidth <= window.innerWidth - margin
      ? fromCard
      : Math.max(margin, pinnedRight);
    const estimatedHeight = Math.min(window.innerHeight * 0.72, 500);
    let top = cardRect.top + Math.min(18, cardRect.height * 0.08);
    top = Math.max(margin, Math.min(top, window.innerHeight - estimatedHeight - margin));
    previewPanel.style.width = `${panelWidth}px`;
    previewPanel.style.left = `${left.toFixed(1)}px`;
    previewPanel.style.top = `${top.toFixed(1)}px`;
  };

  const drawPreviewCurve = () => {
    if (!previewCard || !previewCurve || !previewPath || !previewPanel) return;
    const cardRect = previewCard.getBoundingClientRect();
    const panelRect = previewPanel.getBoundingClientRect();
    const x1 = cardRect.right - 4;
    const y1 = cardRect.top + Math.min(cardRect.height * 0.28, 36);
    const x2 = panelRect.left + 2;
    const y2 = panelRect.top + Math.min(panelRect.height * 0.18, 48);
    const dx = Math.max(40, x2 - x1);
    const c1x = x1 + dx * 0.42;
    const c1y = y1 - Math.min(28, Math.abs(y2 - y1) * 0.15);
    const c2x = x2 - dx * 0.38;
    const c2y = y2 + (y1 < y2 ? -12 : 12);
    const w = window.innerWidth;
    const h = window.innerHeight;
    previewCurve.setAttribute('viewBox', `0 0 ${w} ${h}`);
    previewCurve.setAttribute('width', String(w));
    previewCurve.setAttribute('height', String(h));
    previewPath.setAttribute(
      'd',
      `M ${x1.toFixed(1)} ${y1.toFixed(1)} C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    );
  };

  const syncPreviewGeometry = () => {
    previewFrame = 0;
    if (!previewCard || !previewLayer?.classList.contains('is-visible')) return;
    placePreviewPanel(previewCard);
    drawPreviewCurve();
  };

  const requestPreviewSync = () => {
    if (previewFrame) return;
    previewFrame = window.requestAnimationFrame(syncPreviewGeometry);
  };

  const hidePreview = () => {
    if (previewHideTimer) {
      window.clearTimeout(previewHideTimer);
      previewHideTimer = 0;
    }
    previewCard = null;
    previewLayer?.classList.remove('is-visible');
    previewLayer?.setAttribute('aria-hidden', 'true');
  };

  const showPreview = (card: HTMLElement) => {
    if (!fineHover.matches || !previewLayer || !previewPanel || !previewImages) return;
    // Only while the parent experience panel is open / not inert.
    const host = card.closest<HTMLElement>('[data-experience-projects]');
    if (!host || host.inert || host.getAttribute('aria-hidden') === 'true') return;

    if (previewHideTimer) {
      window.clearTimeout(previewHideTimer);
      previewHideTimer = 0;
    }

    const raw = card.getAttribute('data-preview-src');
    let srcs: string[] = [];
    try {
      srcs = raw ? (JSON.parse(raw) as string[]) : [];
    } catch {
      srcs = [];
    }
    if (!srcs.length) return;

    const same = previewCard === card && previewLayer.classList.contains('is-visible');
    previewCard = card;
    if (!same) loadPreviewImages(srcs);
    placePreviewPanel(card);
    drawPreviewCurve();
    previewLayer.classList.add('is-visible');
    previewLayer.setAttribute('aria-hidden', 'false');
  };

  const scheduleHidePreview = () => {
    if (previewHideTimer) window.clearTimeout(previewHideTimer);
    previewHideTimer = window.setTimeout(hidePreview, 60);
  };

  previewCards.forEach((card) => {
    card.addEventListener('mouseenter', () => showPreview(card));
    card.addEventListener('mouseleave', scheduleHidePreview);
    card.addEventListener('focusin', () => showPreview(card));
    card.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && card.contains(next)) return;
      scheduleHidePreview();
    });
  });

  // Keep the connector attached while open; collapse when the experience panel closes.
  window.addEventListener('scroll', requestPreviewSync, { passive: true });
  window.addEventListener('resize', requestPreviewSync);
  if (experienceList) {
    experienceList.addEventListener('mouseleave', hidePreview);
  }
  const previewObserver = new MutationObserver(() => {
    if (!previewCard) return;
    const host = previewCard.closest<HTMLElement>('[data-experience-projects]');
    if (!host || host.inert || !host.closest('.experience-item.is-open')) {
      hidePreview();
    }
  });
  experienceItems.forEach((item) => {
    previewObserver.observe(item, { attributes: true, attributeFilter: ['class'] });
  });

</script>
