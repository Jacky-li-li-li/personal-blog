---
/**
 * 深浅色按钮。
 *
 * 初始 aria-label 用当前语言渲染（无脚本时也可读），布局里的内联脚本
 * 会在挂载后按实际主题把它改成「切到浅色 / 切到深色」。
 */
import { getUI } from '../i18n';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
---

<button
  class="theme-btn"
  type="button"
  data-theme-toggle
  aria-label={ui.theme.toggleAria}
>
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
    ></path>
  </svg>
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.3A8.6 8.6 0 1 1 9.7 3.5a6.9 6.9 0 0 0 10.8 10.8Z"></path>
  </svg>
</button>
