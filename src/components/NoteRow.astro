---
import type { Note } from '../utils/notes';
import { getNoteSlug } from '../utils/notes';
import { formatDotDate, toIsoDate } from '../utils/date';
import { getFirstSentence } from '../utils/readingTime';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const slug = getNoteSlug(note);
const subtitle = getFirstSentence(note.body ?? '');
---

<article class="note-row">
  <time class="note-date" datetime={toIsoDate(note.data.date)}>{formatDotDate(note.data.date)}</time>

  <div class="note-main">
    <h3 class="note-title">
      <a href={`/notes/${slug}`}>{note.data.title}</a>
    </h3>
    {subtitle && <p class="note-subtitle">{subtitle}</p>}
  </div>

  <span
    class="note-views note-views--hover"
    data-note-views
    data-slug={slug}
    data-mode="read"
    aria-hidden="true"
  ></span>
</article>

<script>
  import '../scripts/note-views';
</script>
